{
  "name": "screenside",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ScreenSide — a student-friendly cyberbullying awareness website",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "worker:build": "wrangler deploy --dry-run --outdir dist-worker",
